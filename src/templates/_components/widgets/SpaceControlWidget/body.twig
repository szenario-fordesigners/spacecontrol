{% set userSettings = plugin('spacecontrol').getSettings() %}
{% set plugin = plugin('spacecontrol') %}
{% set pluginData = plugin.get('settings').getAllPluginData() %}

{% set diskTotalSpace = (userSettings.diskTotalSpace * 1000 * 1000 * 1000) %}
{% set diskUsageAbsolute = ((pluginData.diskUsageAbsolute / 1024 / 1024 / 1024) * 1000000000) | round()  %}
{% set diskUsagePercent = ceil(pluginData.diskUsagePercent) %}

{% set isInitialized = pluginData.isInitialized %}

{% set isConfigured = userSettings.diskTotalSpace > 0 %}

{# only set alert if the plugin has been initialized #}
{% set alert = diskUsagePercent >= 90 and isInitialized and isConfigured %}

{% set messages =  ["plenty of space left","still enough space","getting a bit tight","out of space – take action"]%}
{% set messageIndex = 0 %}

{% if diskUsagePercent < 50 %}
	{% set messageIndex = 0 %}
{% elseif diskUsagePercent < 80 %}
	{% set messageIndex = 1 %}
{% elseif diskUsagePercent < 90 %}
	{% set messageIndex = 2 %}
{% else %}
	{% set messageIndex = 3 %}
{% endif %}

<div class="sCC {{ alert ? " alert" : " " }}" data-initialized="{{ isInitialized }}" data-configured="{{ isConfigured }}">
	{% if isConfigured == false %}
		<div class="sCC-configure">
			<a href="{{ cpUrl('settings/plugins/spacecontrol') }}">
				configure
			</a>
			<div class="sCC-label">
				spacecontrol
			</div>
		</div>
	{% elseif isInitialized == false %}
		<div class="sCC-loading">
			calculating...
		</div>
	{% else %}
		<div class="sCC-topArea">
			<div class="sCC-topArea-left">
				<div class="sCC-circleContainer" data-usage="{{ diskUsagePercent }}">
					<div class="sCC-circle"></div>
					<div class="sCC-circleInner"></div>
				</div>
			</div>
			<div class="sCC-topArea-right">
				<span class="sCC-percentage">
					0
				</span>
			</div>
		</div>
		<div class="sCC-bottomArea">
			<div class="sCC-bottomArea-left">
				<div class="sCC-quota">
					{{ diskTotalSpace / 1000000000}}
					GB
				</div>
				<div class="sCC-webspace">
					Webspace
				</div>
			</div>
			<div class="sCC-bottomArea-right">
				<div class="sCC-used">
					{{ ((diskTotalSpace - diskUsageAbsolute) / 1000000000) | round(2)}}
					GB available
				</div>
				<div class="sCC-info">{{ messages[messageIndex] }}</div>
			</div>
		</div>
		<div class="sCC-label">
			spacecontrol
		</div>
	{% endif %}
</div>
